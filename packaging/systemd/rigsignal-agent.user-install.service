[Unit]
Description=RigSignal metrics agent (user install)
After=network.target

[Service]
Type=simple
# %h expands to the user's home directory at activation time — safe across all users.
# Config search order: ~/.config/rigsignal/rigsignal.toml then /etc/rigsignal/rigsignal.toml
ExecStart=%h/.local/bin/rigsignal-agent
Restart=on-failure
RestartSec=5
Environment=RIGSIGNAL_LOG=info

[Install]
WantedBy=default.target
