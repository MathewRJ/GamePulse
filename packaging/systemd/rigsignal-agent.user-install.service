[Unit]
Description=RigSignal metrics agent
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/rigsignal-agent
Restart=on-failure
RestartSec=5
# Set default log level. Override with: systemctl --user edit rigsignal-agent
# and add [Service] / Environment=RIGSIGNAL_LOG=debug
Environment=RIGSIGNAL_LOG=info

[Install]
WantedBy=default.target
