[Unit]
Description=RigSignal eBPF kernel daemon
After=network.target
# Post-OTA the eBPF binary is wiped from disk; this makes systemd cleanly SKIP
# the unit (condition-failed, not failed) until the manual restore lands — no crash-loop.
ConditionPathExists=/usr/bin/rigsignal-ebpf

[Service]
Type=simple
ExecStart=/usr/bin/rigsignal-ebpf --config /etc/rigsignal/rigsignal.toml --probe-path /usr/lib/rigsignal/rigsignal-ebpf-probes
Restart=on-failure
RestartSec=5
# eBPF requires elevated capabilities
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
