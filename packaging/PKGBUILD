# Maintainer: MathewRJ <https://github.com/MathewRJ>
# AUR: https://aur.archlinux.org/packages/rigsignal
#
# For AUR submission, replace the local source= line below with:
#   source=("${pkgname}-${pkgver}::git+https://github.com/MathewRJ/RigSignal.git#tag=v${pkgver}")
#   sha256sums=('SKIP')
pkgname=rigsignal
pkgver=0.3.5
pkgrel=1
pkgdesc="Gaming performance telemetry agent — ships CPU/GPU/memory/frame metrics to Elasticsearch"
arch=('x86_64')
url="https://github.com/MathewRJ/RigSignal"
license=('Apache')
depends=('python3')
makedepends=('rust')
optdepends=('mangohud: frame timing data collection')
install=rigsignal.install
# Disable LTO: ring's build script compiles C/ASM via cc and produces GCC LTO
# bitcode objects when CFLAGS contains -flto. Rust's LLD linker cannot resolve
# symbols from GCC LTO objects, causing undefined symbol errors at link time.
options=(!lto)

# Local source: the packaging/ dir lives inside the repo, so $startdir/.. is the repo root.
# makepkg copies nothing for an empty source array — we reference files directly via $startdir.
source=()
sha256sums=()

_repodir="$(realpath "$startdir/..")"

prepare() {
    # The engine is a staged release payload, not a source-tree fallback.  Its
    # stamp must match the commit compiled into the agent below.
    python3 "${_repodir}/tools/build_asset_bundle.py" \
        --source-commit "$(git -C "${_repodir}" rev-parse HEAD)" \
        --output "${srcdir}/rigsignal-assets-${pkgver}.tar.gz" \
        --engine-output "${_repodir}/dist/engine"
}

build() {
    # Change to repo root so that cargo finds .cargo/config.toml
    # (which sets linker=cc for the ring crate) from the correct path hierarchy.
    # makepkg's $srcdir is an unrelated directory; running from there prevents
    # cargo from discovering the linker config.
    cd "${_repodir}"

    # --- Build the Rust agent ---
    echo "==> Building rigsignal-agent (release)..."
    cargo build --release --manifest-path src/Cargo.toml

}

package() {
    # ---- Binaries ----
    install -Dm755 "${_repodir}/target/release/rigsignal-agent" \
        "${pkgdir}/usr/bin/rigsignal-agent"
    install -Dm755 "${_repodir}/packaging/rigsignal-spool-retention.py" \
        "${pkgdir}/usr/bin/rigsignal-spool-retention"
    # ---- systemd user unit (rigsignal-agent runs as the gaming user) ----
    install -Dm644 "${startdir}/systemd/rigsignal-agent.service" \
        "${pkgdir}/usr/lib/systemd/user/rigsignal-agent.service"
    install -Dm644 "${startdir}/systemd/rigsignal-spool-retention.service" \
        "${pkgdir}/usr/lib/systemd/user/rigsignal-spool-retention.service"
    install -Dm644 "${startdir}/systemd/rigsignal-spool-retention.timer" \
        "${pkgdir}/usr/lib/systemd/user/rigsignal-spool-retention.timer"

    # ---- Launcher CLI ----
    # Single entry-point for start/stop/run/setup subcommands.
    # 'rigsignal run %command%' is the Steam launch option form.
    install -Dm755 "${startdir}/rigsignal-launcher.sh" \
        "${pkgdir}/usr/bin/rigsignal"

    # Staged by the release build; the launcher deliberately uses only this
    # system-scope engine with the system launcher and agent.
    install -Dm755 "${_repodir}/dist/engine/install_assets.py" \
        "${pkgdir}/usr/lib/rigsignal/engine/install_assets.py"
    install -Dm644 "${_repodir}/dist/engine/asset_adapters.py" \
        "${pkgdir}/usr/lib/rigsignal/engine/asset_adapters.py"
    install -Dm644 "${_repodir}/dist/engine/_version.py" \
        "${pkgdir}/usr/lib/rigsignal/engine/_version.py"
    printf 'rigsignal-release\n' > "${pkgdir}/usr/lib/rigsignal/engine/channel"
    chmod 644 "${pkgdir}/usr/lib/rigsignal/engine/channel"

    # ---- Example config ----
    # The launcher writes the live, credential-bearing user config under XDG_CONFIG_HOME.
    # /etc/rigsignal/rigsignal.toml remains reserved for the root eBPF service.
    install -Dm644 "${startdir}/config/rigsignal.toml.example" \
        "${pkgdir}/usr/share/rigsignal/examples/rigsignal.toml.example"
}
