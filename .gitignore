# Python
collector/.venv/
collector/__pycache__/
collector/**/__pycache__/
collector/**/*.pyc
collector/.pytest_cache/
collector/dist/
collector/*.egg-info/

# elastic-package build output
build/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Claude Code local settings (not for commit)
.claude/settings.local.json

# Claude Code skill symlinks — directory symlinks that break elastic-package build.
# Claude Code agent skills — dev tooling, not part of the integration package.
# Recreate with: npx skills add elastic/agent-skills -a claude-code
.claude/skills/
.agents/
# Exception: GamePulse-specific skills ARE committed (regular dirs, no symlinks)
!.agents/skills/elasticsearch-tsds/
!.agents/skills/gamepulse-data-model/
!.agents/skills/gamepulse-workflow/
!.agents/skills/elastic-mcp-setup/

# MCP server config — contains credentials; .example is committed, real file is not
.mcp.json

# Git worktrees for Codex implementation tasks — local only, never commit
worktrees/
.claude/worktrees/

# gpx orchestrator local state — log of every agent invocation
.gpx/

# Browser-auth storage-state for the Kibana UI verifier — never commit
*.storage-state.json
.gpx/kibana-auth.storage-state.json

# UI verification artefacts — screenshots and failure dumps
artifacts/dashboard-ui/

# Playwright local install (we recommend npm install --no-save)
node_modules/
