# Python (archived collector)
__pycache__/
archive/collector/.venv/
archive/collector/__pycache__/
archive/collector/**/__pycache__/
archive/collector/**/*.pyc
archive/collector/.pytest_cache/
archive/collector/dist/
archive/collector/*.egg-info/

# elastic-package build output
build/

# Build artifacts / OS noise
a.out
*.pkg.tar.zst
target/
src/target/
ebpf/target/

# AI scaffolding (lives in ~/coding/Workflow, not here)
.agents/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Claude Code local settings (not for commit)
.claude/settings.local.json


# MCP server config — contains credentials; .example is committed, real file is not
.mcp.json
# Credential-bearing env files. The MCP setup guide tells operators to put
# RIGSIGNAL_MCP_API_KEY in a .env file "that is also gitignored" -- it was not,
# so following that instruction literally committed a live key. Found by the
# push-time security audit, 2026-08-28.
.env
.env.*
local.env



# Browser-auth storage-state for the Kibana UI verifier — never commit
*.storage-state.json
.gpx/

# UI verification artefacts — screenshots and failure dumps
artifacts/dashboard-ui/

# Playwright local install (we recommend npm install --no-save)
node_modules/

# docs/archive/ is intentionally tracked — sanitised history for contributors
!docs/archive/

# AI orchestration artifacts stay out of this repo (see Workflow repo)
worktrees/
packaging/.claude/

# 0.2.3 deploy staging — binaries are build artifacts; SHA256SUMS is the tracked record
deploy-staging/rigsignal-agent
deploy-staging/rigsignal-ebpf
deploy-staging/rigsignal-ebpf-probes

# TK-2: raw cluster exports (input-only, never commit) + local bundle output
tools/asset-export-*/
dist/
