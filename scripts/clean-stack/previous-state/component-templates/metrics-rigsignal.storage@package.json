{
  "_meta": {
    "managed": true,
    "managed_by": "fleet",
    "package": {
      "name": "rigsignal"
    }
  },
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "ignore_malformed": false,
          "type": "date"
        },
        "data_stream": {
          "properties": {
            "dataset": {
              "type": "constant_keyword"
            },
            "namespace": {
              "type": "constant_keyword"
            },
            "type": {
              "type": "constant_keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "time_series_dimension": true,
              "type": "keyword"
            }
          }
        },
        "rigsignal": {
          "properties": {
            "game": {
              "properties": {
                "launcher": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "source": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "steam_app_id": {
                  "type": "long"
                }
              }
            },
            "session": {
              "properties": {
                "agent_version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "id": {
                  "time_series_dimension": true,
                  "type": "keyword"
                },
                "label": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "storage": {
              "properties": {
                "drive_temperature_c": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "game_process_read_mb": {
                  "meta": {},
                  "time_series_metric": "counter",
                  "type": "float"
                },
                "game_process_read_ops": {
                  "meta": {},
                  "time_series_metric": "counter",
                  "type": "long"
                },
                "game_process_write_mb": {
                  "meta": {},
                  "time_series_metric": "counter",
                  "type": "float"
                },
                "io_latency_read_us": {
                  "properties": {
                    "avg": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p50": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p95": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p99": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    }
                  }
                },
                "io_latency_write_us": {
                  "properties": {
                    "avg": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p50": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p95": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    },
                    "p99": {
                      "meta": {},
                      "time_series_metric": "gauge",
                      "type": "long"
                    }
                  }
                },
                "io_wait_pct": {
                  "meta": {
                    "unit": "percent"
                  },
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "merged_reads": {
                  "meta": {},
                  "time_series_metric": "counter",
                  "type": "long"
                },
                "merged_writes": {
                  "meta": {},
                  "time_series_metric": "counter",
                  "type": "long"
                },
                "queue_depth_current": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "queue_depth_max": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "read_iops": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "read_mbps": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "write_iops": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "write_mbps": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "index": {
        "default_pipeline": "metrics-rigsignal.storage-0.5.0",
        "lifecycle": {
          "name": "metrics@lifecycle"
        },
        "mapping": {
          "source": {
            "mode": "synthetic"
          },
          "total_fields": {
            "limit": "1000"
          }
        }
      }
    }
  }
}
