{
  "_meta": {
    "managed": true,
    "managed_by": "fleet",
    "package": {
      "name": "rigsignal"
    }
  },
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "ignore_malformed": false,
          "type": "date"
        },
        "data_stream": {
          "properties": {
            "dataset": {
              "type": "constant_keyword"
            },
            "namespace": {
              "type": "constant_keyword"
            },
            "type": {
              "type": "constant_keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "time_series_dimension": true,
              "type": "keyword"
            }
          }
        },
        "rigsignal": {
          "properties": {
            "game": {
              "properties": {
                "launcher": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "source": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "steam_app_id": {
                  "type": "long"
                }
              }
            },
            "network": {
              "properties": {
                "bandwidth_utilisation_mbps": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "connection_type": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "interface": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "packet_loss_pct": {
                  "meta": {
                    "unit": "percent"
                  },
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "rtt_ms": {
                  "meta": {
                    "unit": "ms"
                  },
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "rx_mbps": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "rx_packets_per_sec": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "tcp_retransmits_per_sec": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "tx_mbps": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "tx_packets_per_sec": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                }
              }
            },
            "session": {
              "properties": {
                "agent_version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "id": {
                  "time_series_dimension": true,
                  "type": "keyword"
                },
                "label": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "index": {
        "default_pipeline": "metrics-rigsignal.network-0.5.0",
        "lifecycle": {
          "name": "metrics@lifecycle"
        },
        "mapping": {
          "source": {
            "mode": "synthetic"
          },
          "total_fields": {
            "limit": "1000"
          }
        }
      }
    }
  }
}
