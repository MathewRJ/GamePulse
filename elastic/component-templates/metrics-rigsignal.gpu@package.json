{
  "_meta": {
    "managed": true,
    "managed_by": "rigsignal-asset-bundle",
    "package": {
      "name": "rigsignal"
    }
  },
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "ignore_malformed": false,
          "type": "date"
        },
        "data_stream": {
          "properties": {
            "dataset": {
              "type": "constant_keyword"
            },
            "namespace": {
              "type": "constant_keyword"
            },
            "type": {
              "type": "constant_keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "time_series_dimension": true,
              "type": "keyword"
            }
          }
        },
        "rigsignal": {
          "properties": {
            "game": {
              "properties": {
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "steam_app_id": {
                  "type": "long"
                }
              }
            },
            "gpu": {
              "properties": {
                "clock_mhz": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "fan_pct": {
                  "meta": {
                    "unit": "percent"
                  },
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "fan_speed_rpm": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "hotspot_c": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "memory_temperature_c": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "memory_total_mb": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "memory_used_mb": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "power_w": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "temp_source": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "temperature_c": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "thermal_throttle_warning": {
                  "type": "boolean"
                },
                "utilisation_pct": {
                  "meta": {
                    "unit": "percent"
                  },
                  "time_series_metric": "gauge",
                  "type": "float"
                },
                "voltage": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "float"
                }
              }
            },
            "session": {
              "properties": {
                "agent_version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "id": {
                  "time_series_dimension": true,
                  "type": "keyword"
                },
                "label": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "index": {
        "default_pipeline": "metrics-rigsignal.gpu-0.5.0",
        "lifecycle": {
          "name": "metrics@lifecycle"
        },
        "mapping": {
          "source": {
            "mode": "synthetic"
          },
          "total_fields": {
            "limit": "1000"
          }
        }
      }
    }
  }
}
