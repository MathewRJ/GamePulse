{
  "template": {
    "mappings": {
      "properties": {
        "gamepulse": {
          "properties": {
            "audio": {
              "properties": {
                "backend": {
                  "type": "keyword",
                  "ignore_above": 32
                },
                "sample_rate_hz": {
                  "type": "integer"
                },
                "buffer_size": {
                  "type": "integer"
                },
                "latency_ms": {
                  "type": "float"
                },
                "xruns": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Audio telemetry: backend (PipeWire/PulseAudio/ALSA/WASAPI), sample rate, buffer size, latency, and buffer underrun/overrun count.",
    "version": "1.1.0"
  }
}
