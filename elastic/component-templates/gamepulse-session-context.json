{
  "template": {
    "mappings": {
      "properties": {
        "session_id": {
          "type": "keyword",
          "ignore_above": 64
        },
        "agent_version": {
          "type": "keyword",
          "ignore_above": 32
        },
        "user_id": {
          "type": "keyword",
          "ignore_above": 64
        },
        "opt_in_public": {
          "type": "boolean"
        },
        "summary": {
          "properties": {
            "ended": {
              "type": "boolean"
            },
            "duration_s": {
              "type": "integer"
            },
            "avg_fps": {
              "type": "float"
            },
            "low_1pct_fps": {
              "type": "integer"
            },
            "peak_gpu_temp_c": {
              "type": "float"
            },
            "peak_cpu_temp_c": {
              "type": "float"
            },
            "stutter_count": {
              "type": "integer"
            },
            "bottleneck_dominant": {
              "type": "keyword",
              "ignore_above": 16
            }
          }
        },
        "game": {
          "properties": {
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "source": {
              "type": "keyword",
              "ignore_above": 32
            },
            "launcher": {
              "type": "keyword",
              "ignore_above": 128
            },
            "steam_app_id": {
              "type": "long"
            },
            "version": {
              "type": "keyword",
              "ignore_above": 64
            },
            "launch_args": {
              "type": "keyword",
              "ignore_above": 256
            },
            "graphics_api": {
              "type": "keyword",
              "ignore_above": 32
            },
            "upscaler": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 32
                },
                "quality": {
                  "type": "keyword",
                  "ignore_above": 32
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Shared session context fields included in every GamePulse data stream. Contains session identification, game metadata, and agent version.",
    "version": "1.0.0"
  }
}
