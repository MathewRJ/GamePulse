                    "capacity_gb": {
                      "type": "integer"
                    },
                    "free_gb": {
                      "type": "integer"
                    },
                    "filesystem": {
                      "type": "keyword",
                      "ignore_above": 16
                    }
                  }
                }
              }
            },
            "device": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 32
                },
                "model": {
                  "type": "text",
                  "fields": {
                    "keyword": {
                      "type": "keyword",
                      "ignore_above": 64
