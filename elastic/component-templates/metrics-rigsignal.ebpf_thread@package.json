{
  "_meta": {
    "managed": true,
    "managed_by": "rigsignal-asset-bundle",
    "package": {
      "name": "rigsignal"
    }
  },
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": {
          "ignore_malformed": false,
          "type": "date"
        },
        "data_stream": {
          "properties": {
            "dataset": {
              "type": "constant_keyword"
            },
            "namespace": {
              "type": "constant_keyword"
            },
            "type": {
              "type": "constant_keyword"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "time_series_dimension": true,
              "type": "keyword"
            },
            "os": {
              "properties": {
                "kernel": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            }
          }
        },
        "rigsignal": {
          "properties": {
            "ebpf_thread": {
              "properties": {
                "comm": {
                  "time_series_dimension": true,
                  "type": "keyword"
                },
                "migration_count": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "probe": {
                  "time_series_dimension": true,
                  "type": "keyword"
                },
                "rank": {
                  "type": "long"
                },
                "runqueue_avg_us": {
                  "meta": {
                    "unit": "micros"
                  },
                  "time_series_metric": "gauge",
                  "type": "double"
                },
                "runqueue_max_us": {
                  "meta": {
                    "unit": "micros"
                  },
                  "time_series_metric": "gauge",
                  "type": "double"
                },
                "runqueue_min_us": {
                  "meta": {
                    "unit": "micros"
                  },
                  "time_series_metric": "gauge",
                  "type": "double"
                },
                "switch_count": {
                  "meta": {},
                  "time_series_metric": "gauge",
                  "type": "long"
                },
                "tid": {
                  "time_series_dimension": true,
                  "type": "long"
                }
              }
            },
            "session": {
              "properties": {
                "id": {
                  "time_series_dimension": true,
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "index": {
        "default_pipeline": "metrics-rigsignal.ebpf_thread-0.5.0",
        "lifecycle": {
          "name": "metrics@lifecycle"
        },
        "mapping": {
          "source": {
            "mode": "synthetic"
          },
          "total_fields": {
            "limit": "1000"
          }
        }
      }
    }
  }
}
