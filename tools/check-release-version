#!/usr/bin/env python3
"""Fail closed when release-version sources disagree.

The guard deliberately obtains crate versions through `cargo metadata --locked`:
without `--locked`, Cargo can repair a stale lockfile before this program sees it.
"""

import argparse
import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path


EXPECTED_MEMBERS = {
    "root": {
        "src/Cargo.toml": "rigsignal",
    },
    "ebpf": {
        "ebpf/rigsignal-ebpf-probes/Cargo.toml": "rigsignal-ebpf-probes",
        "ebpf/rigsignal-ebpf/Cargo.toml": "rigsignal-ebpf",
        "ebpf/xtask/Cargo.toml": "xtask",
    },
}
PRODUCT_CRATES = {"rigsignal", "rigsignal-ebpf", "rigsignal-ebpf-probes"}
LOCK_CRATES = {
    "Cargo.lock": ("rigsignal",),
    "ebpf/Cargo.lock": ("rigsignal-ebpf", "rigsignal-ebpf-probes"),
}
SEMVER_TAG = re.compile(
    r"v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"
    r"(?:-(?:0|[0-9A-Za-z-]*[0-9A-Za-z])[0-9A-Za-z.-]*)?"
    r"(?:\+[0-9A-Za-z.-]+)?$"
)
RELEASE_HEADING = re.compile(r"^## \[([^]]+)\] — .+$")


class GuardFailure(Exception):
    """A release source was missing or inconsistent."""


def validate_version_string(version: str) -> None:
    if not SEMVER_TAG.fullmatch(version):
        raise GuardFailure(f"version must be a nonempty v<semver> string, got {version!r}")


def metadata(repo_root: Path, manifest: Path) -> dict:
    command = [
        "cargo",
        "metadata",
        "--locked",
        "--no-deps",
        "--format-version",
        "1",
        "--manifest-path",
        str(manifest),
    ]
    result = subprocess.run(command, cwd=repo_root, text=True, capture_output=True)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip()
        raise GuardFailure(
            f"cargo metadata --locked failed for {manifest.relative_to(repo_root)}: {detail}"
        )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise GuardFailure(
            f"cargo metadata produced invalid JSON for {manifest.relative_to(repo_root)}: {error}"
        ) from error


def member_versions(repo_root: Path, workspace: str, data: dict) -> dict[str, str]:
    packages = {package["id"]: package for package in data["packages"]}
    actual: dict[str, str] = {}
    failures: list[str] = []
    for package_id in data["workspace_members"]:
        package = packages.get(package_id)
        if package is None:
            failures.append(f"{workspace} workspace member {package_id!r} is absent from metadata packages")
            continue
        try:
            manifest = Path(package["manifest_path"]).resolve().relative_to(repo_root).as_posix()
        except ValueError:
            failures.append(
                f"{workspace} workspace member {package['name']} is outside repository: "
                f"{package['manifest_path']}"
            )
            continue
        actual[manifest] = package["name"]

    expected = EXPECTED_MEMBERS[workspace]
    unexpected = sorted(set(actual).difference(expected))
    missing = sorted(set(expected).difference(actual))
    for manifest in unexpected:
        failures.append(f"unexpected {workspace} workspace member: {manifest} ({actual[manifest]})")
    for manifest in missing:
        failures.append(f"missing expected {workspace} workspace member: {manifest} ({expected[manifest]})")
    for manifest, name in expected.items():
        if manifest in actual and actual[manifest] != name:
            failures.append(
                f"{workspace} workspace member {manifest} is {actual[manifest]!r}, expected {name!r}"
            )
    if failures:
        raise GuardFailure("\n".join(failures))

    versions = {}
    for package_id in data["workspace_members"]:
        package = packages[package_id]
        if package["name"] in PRODUCT_CRATES:
            versions[package["name"]] = package["version"]
    return versions


def lock_version(lockfile: Path, package_name: str) -> str:
    try:
        with lockfile.open("rb") as handle:
            packages = tomllib.load(handle).get("package", [])
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise GuardFailure(f"cannot read {lockfile}: {error}") from error
    matches = [
        package for package in packages
        if package.get("name") == package_name and "source" not in package
    ]
    if len(matches) != 1:
        found = ", ".join(
            f"version={package.get('version')!r}, source={package.get('source')!r}"
            for package in matches
        ) or "none"
        raise GuardFailure(
            f"{lockfile}: expected exactly one source-less local package {package_name!r}; found {found}"
        )
    version = matches[0].get("version")
    if not isinstance(version, str):
        raise GuardFailure(f"{lockfile}: local package {package_name!r} has no string version")
    return version


def top_released_version(changelog: Path) -> str:
    try:
        lines = changelog.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        raise GuardFailure(f"cannot read {changelog}: {error}") from error
    for line in lines:
        match = RELEASE_HEADING.fullmatch(line)
        if match:
            return match.group(1)
    raise GuardFailure(f"{changelog}: no released heading matching '## [version] — date'")


def check(repo_root: Path, tag: str | None) -> None:
    root_metadata = metadata(repo_root, repo_root / "Cargo.toml")
    ebpf_metadata = metadata(repo_root, repo_root / "ebpf/Cargo.toml")
    versions = {
        **member_versions(repo_root, "root", root_metadata),
        **member_versions(repo_root, "ebpf", ebpf_metadata),
    }
    missing_products = PRODUCT_CRATES.difference(versions)
    if missing_products:
        raise GuardFailure(f"cargo metadata omitted product crates: {', '.join(sorted(missing_products))}")

    expected_version = versions["rigsignal"]
    failures = [
        f"crate {name} is {version}, expected {expected_version}"
        for name, version in sorted(versions.items())
        if version != expected_version
    ]
    for lock_name, package_names in LOCK_CRATES.items():
        lockfile = repo_root / lock_name
        for package_name in package_names:
            version = lock_version(lockfile, package_name)
            if version != expected_version:
                failures.append(
                    f"{lock_name} local package {package_name} is {version}, expected {expected_version}"
                )
    changelog_version = top_released_version(repo_root / "CHANGELOG.md")
    if changelog_version != expected_version:
        failures.append(
            f"CHANGELOG.md top released section is {changelog_version}, expected {expected_version}"
        )
    if tag is not None:
        if not SEMVER_TAG.fullmatch(tag):
            failures.append(f"tag must be a nonempty v<semver> string, got {tag!r}")
        elif tag[1:] != expected_version:
            failures.append(f"tag {tag} does not match crate version {expected_version}")
    if failures:
        raise GuardFailure("\n".join(failures))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--tag", help="release tag to assert as v<semver>")
    parser.add_argument(
        "--validate-version-string",
        metavar="VERSION",
        help="validate a v<semver> string without inspecting the repository",
    )
    args = parser.parse_args()
    try:
        if args.validate_version_string is not None:
            validate_version_string(args.validate_version_string)
        else:
            check(args.repo_root.resolve(), args.tag)
    except GuardFailure as error:
        print(f"release-version guard failed:\n{error}", file=sys.stderr)
        return 1
    print("release-version guard passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
