#!/usr/bin/env bash
# Workflow opt-in pre-push hook — template for all managed projects.
#
# Install in any project with:
#   cp ~/coding/Workflow/.githooks/pre-push .githooks/pre-push
#   git config core.hooksPath .githooks
#
# Disable with:
#   git config --unset core.hooksPath
#
# Behaviour:
#   - On push to main:               run `gpx audit security` (block on REJECT)
#   - On push to any other branch:   no-op (return 0)
#   - Bypass with:                   git push --no-verify
#
# Auth: uses the local `claude` CLI authenticated via your Pro subscription.
# No API key required. No network call to Anthropic API.

set -e

# Read every ref being pushed FIRST (stdin is delivered once). Collected here so
# the tag-binding gate below runs even when gpx is absent (that branch is
# deliberately fail-open for AUDITS, and must not swallow the tag check).
audit_main=0
main_range=""
main_new_sha=""
vtag_refs=()
while read -r local_ref local_sha remote_ref remote_sha; do
  case "${remote_ref}" in
    refs/heads/main)
      audit_main=1
      main_range="${remote_sha} ${local_sha}"
      main_new_sha="${local_sha}"
      ;;
    refs/tags/v*)
      vtag_refs+=("${remote_ref} ${local_sha}")
      ;;
  esac
done

# Tag-binding gate (2026-08-26): a v* tag names a release. The audit machinery
# only covers main pushes, so an arbitrary v* tag would publish an unaudited
# commit through the release workflow's tag trigger. Bind every pushed v* tag
# to the main tip: either the main sha pushed alongside it, or (tag-only push)
# the local origin/main tracking ref. DELIBERATELY STRICT: a hotfix tag on a
# non-tip commit is refused — that is the documented `git push --no-verify`
# case. Tag deletions are allowed (removing a tag publishes nothing).
ZERO40="0000000000000000000000000000000000000000"
for entry in ${vtag_refs[@]+"${vtag_refs[@]}"}; do
  tag_ref="${entry%% *}"
  tag_sha="${entry##* }"
  if [[ "${tag_sha}" == "${ZERO40}" ]]; then
    continue
  fi
  peeled="$(git rev-parse --verify --quiet "${tag_sha}^{commit}" || true)"
  if [[ -z "${peeled}" ]]; then
    echo "[pre-push] REFUSED: ${tag_ref} does not peel to a commit." >&2
    exit 1
  fi
  if [[ -n "${main_new_sha}" && "${main_new_sha}" != "${ZERO40}" ]]; then
    bind_target="${main_new_sha}"
    bind_desc="the main tip pushed alongside it"
  else
    bind_target="$(git rev-parse --verify --quiet 'origin/main^{commit}' || true)"
    bind_desc="local origin/main (run 'git fetch' first if stale)"
  fi
  if [[ -z "${bind_target}" || "${peeled}" != "${bind_target}" ]]; then
    echo "[pre-push] REFUSED: ${tag_ref} peels to ${peeled}, not ${bind_target:-<absent>} (${bind_desc})." >&2
    echo "[pre-push] Release tags must point at the audited main tip. Push main first (sequential main-then-tag), or bypass deliberately with: git push --no-verify" >&2
    exit 1
  fi
  echo "[pre-push] tag-binding: ${tag_ref} peels to ${bind_desc} — allowed"
done

# Always use the Workflow repo's gpx (not a project-local copy)
GPX="${HOME}/coding/Workflow/bin/gpx"

if [[ ! -x "${GPX}" ]]; then
  echo "[pre-push] gpx not found at ${GPX} — skipping audit" >&2
  exit 0
fi

if [[ "${audit_main}" -eq 0 ]]; then
  exit 0
fi

# Binding check (2026-08-26 review finding): `gpx audit security` audits the
# CHECKOUT's origin/main...HEAD, so the gate is only meaningful when the sha
# being pushed to main IS that HEAD. Refuse anything else (e.g.
# `git push origin other-ref:main`) instead of approving an unaudited ref.
# This gap predates the stamp; the stamp just made it visible.
head_sha="$(git rev-parse HEAD)"
pushed_sha="${main_range##* }"
if [[ "${pushed_sha}" != "${head_sha}" ]]; then
  echo "[pre-push] REFUSED: pushing ${pushed_sha} to main, but the audit covers the checkout HEAD (${head_sha})." >&2
  echo "[pre-push] Check out the ref you are pushing (so HEAD == pushed sha) and push again." >&2
  exit 1
fi

# Drift check (audit note N2, 2026-08-26): the audit diffs origin/main...HEAD
# (the local TRACKING ref) while ${main_range} carries the REAL remote tip from
# transport negotiation. If they diverge (stale tracking ref after a remote
# rewind/force-push) the audit could cover a subset of what lands. Fail closed;
# with this check the stamp really does record the audited range.
tracking_sha="$(git rev-parse --verify --quiet 'origin/main^{commit}' || true)"
remote_tip="${main_range%% *}"
if [[ "${remote_tip}" != "${tracking_sha}" ]]; then
  echo "[pre-push] REFUSED: local origin/main (${tracking_sha:-absent}) does not match the remote tip (${remote_tip}) — run 'git fetch' and retry." >&2
  exit 1
fi

# Range-bound approval stamp (2026-08-25): git opens the ssh transport BEFORE
# running this hook, so a multi-minute audit lets the connection die and the
# pack send fails with SIGPIPE AFTER an APPROVE. The stamp records the exact
# audited range; a retry push of the SAME range within 30 min passes the gate
# instantly (inside the transport window). Any new range re-audits. This is a
# latency fix, not a bypass — every pushed range is still audited.
STAMP="$(git rev-parse --git-dir)/rigsignal-audit-approved"
if [[ -f "${STAMP}" ]]; then
  stamp_mtime="$(stat -c %Y "${STAMP}" 2>/dev/null || stat -f %m "${STAMP}" 2>/dev/null || echo 0)"
  stamp_age=$(( $(date +%s) - stamp_mtime ))
  if [[ "${stamp_age}" -lt 1800 ]] && [[ "$(cat "${STAMP}")" == "${main_range}" ]]; then
    echo "[pre-push] fresh audit approval stamp matches this exact range (${stamp_age}s old) — gate satisfied"
    exit 0
  fi
fi

echo "[pre-push] push to main detected — running gpx audit security"
echo "[pre-push] (bypass with: git push --no-verify)"
# Pin the audit target to THIS repo (audit note N1, 2026-08-26): GPX_PROJECT is
# a documented user-settable env var — if exported in the pushing shell, gpx
# would silently audit a DIFFERENT project's diff and this hook would stamp
# this repo's range as approved.
GPX_PROJECT="$(git rev-parse --show-toplevel)" "${GPX}" audit security
printf '%s' "${main_range}" > "${STAMP}"
echo "[pre-push] audit passed — approval stamped for range: ${main_range}"
