<?xml version='1.0' encoding='windows-1252'?>
<!--
    RigSignal Windows installer (WiX 3.x source)

    Authored by hand rather than via `cargo wix init` so the layout matches
    the Linux .deb / .rpm / Arch packages: a single Program Files\RigSignal\
    install root with bin\ + config\ + profiles\ subfolders, plus a PATH
    entry so `rigsignal-agent` works from any shell.

    Built variables:
        $(var.Version)            - from src/Cargo.toml [package].version (cargo-wix)
        $(var.CargoTargetBinDir)  - target/release (cargo-wix, via cargo metadata)
        $(sys.SOURCEFILEDIR)      - dir of this wxs file (WiX preprocessor)

    GUIDs:
        UpgradeCode and the per-component GUIDs are stable across releases.
        Changing UpgradeCode would prevent MSI from detecting an upgrade and
        would leave the previous version installed alongside the new one.
        Changing path-component GUID would orphan the PATH entry on uninstall.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='RigSignal'
        UpgradeCode='862FBC47-5257-4EC9-9854-0D10D2B8FD29'
        Manufacturer='MathewRJ'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='RigSignal gaming performance telemetry agent'
            Manufacturer='MathewRJ'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of RigSignal is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='RigSignal Installation'/>

        <!-- Install layout -->
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='RigSignal'>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='AgentBinary' Guid='335B8F3D-B991-494F-8995-E8A5BDA35A6C' Win64='yes'>
                            <File
                                Id='RigsignalAgentExe'
                                Name='rigsignal-agent.exe'
                                Source='$(var.CargoTargetBinDir)\rigsignal-agent.exe'
                                KeyPath='yes'
                                DiskId='1'/>
                        </Component>
                        <Component Id='PathEntry' Guid='CC21BF89-4193-4289-8D44-847AA7B6EC72' Win64='yes' KeyPath='yes'>
                            <Environment
                                Id='UpdatePath'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                    </Directory>

                    <Directory Id='ConfigDir' Name='config'>
                        <Component Id='ConfigExample' Guid='95548900-CAE1-43DF-91C4-51DA81F16BAF' Win64='yes'>
                            <File
                                Id='RigsignalTomlExample'
                                Name='rigsignal.toml.example'
                                Source='$(sys.SOURCEFILEDIR)..\..\packaging\config\rigsignal.toml.example'
                                KeyPath='yes'
                                DiskId='1'/>
                        </Component>
                    </Directory>

                    <Directory Id='ProfilesDir' Name='profiles'>
                        <Component Id='Profiles' Guid='17D6C34F-48AE-474D-8BD6-A1ED5EAC9802' Win64='yes'>
                            <File
                                Id='ProfileStarfield'
                                Name='starfield.toml'
                                Source='$(sys.SOURCEFILEDIR)..\..\profiles\starfield.toml'
                                KeyPath='yes'
                                DiskId='1'/>
                            <File
                                Id='ProfileCyberpunk'
                                Name='cyberpunk-2077.toml'
                                Source='$(sys.SOURCEFILEDIR)..\..\profiles\cyberpunk-2077.toml'
                                DiskId='1'/>
                            <File
                                Id='ProfileBaldursGate3'
                                Name='baldurs-gate-3.toml'
                                Source='$(sys.SOURCEFILEDIR)..\..\profiles\baldurs-gate-3.toml'
                                DiskId='1'/>
                        </Component>
                    </Directory>

                </Directory>
            </Directory>
        </Directory>

        <Feature Id='Main'
                 Title='RigSignal'
                 Description='RigSignal agent + bundled profiles'
                 Level='1'
                 ConfigurableDirectory='APPLICATIONFOLDER'
                 AllowAdvertise='no'
                 Display='expand'
                 Absent='disallow'>
            <ComponentRef Id='AgentBinary'/>
            <ComponentRef Id='PathEntry'/>
            <ComponentRef Id='ConfigExample'/>
            <ComponentRef Id='Profiles'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/MathewRJ/RigSignal'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/MathewRJ/RigSignal'/>

    </Product>

</Wix>
