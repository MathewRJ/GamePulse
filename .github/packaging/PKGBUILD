# CI-only PKGBUILD — agent-only (no eBPF), pre-built binary.
#
# This file is used by .github/workflows/release.yml and is NOT the AUR
# PKGBUILD (which lives at packaging/PKGBUILD and builds from source including
# the eBPF daemon). Kept separate so CI can package a pre-built binary without
# the nightly Rust + bpf-linker toolchain the eBPF build requires.
#
# Environment variables expected at makepkg invocation time:
#   PKGVER   — release version string without leading 'v' (e.g. 0.2.0)
#   REPOROOT — absolute path to the RigSignal repo root
#
# Invocation (from .github/packaging/):
#   PKGVER=0.2.0 REPOROOT=/path/to/repo makepkg --nodeps --noextract --nosign

pkgname=rigsignal
pkgver="${PKGVER:-0.2.0}"
pkgrel=1
pkgdesc="RigSignal gaming performance telemetry agent — ships CPU/GPU/memory/frame metrics to Elasticsearch"
arch=('x86_64')
url="https://github.com/MathewRJ/RigSignal"
license=('MIT')
depends=()
optdepends=('mangohud: frame timing data collection')
backup=('etc/rigsignal/rigsignal.toml')
source=()
sha256sums=()

# Resolve absolute path at parse time so the fakeroot package() call can find files.
_reporoot="$(realpath "${REPOROOT:-../..}")"

package() {
    install -Dm755 "${_reporoot}/target/release/rigsignal-agent" \
        "${pkgdir}/usr/bin/rigsignal-agent"

    install -Dm755 "${_reporoot}/packaging/rigsignal-launcher.sh" \
        "${pkgdir}/usr/bin/rigsignal"

    install -Dm644 "${_reporoot}/packaging/systemd/rigsignal-agent.service" \
        "${pkgdir}/usr/lib/systemd/user/rigsignal-agent.service"

    install -Dm644 "${_reporoot}/packaging/systemd/rigsignal-ebpf.service" \
        "${pkgdir}/usr/lib/systemd/system/rigsignal-ebpf.service"

    install -Dm644 "${_reporoot}/packaging/config/rigsignal.toml.example" \
        "${pkgdir}/etc/rigsignal/rigsignal.toml"

    # ---- Starter game profiles ----
    for _profile in "${_reporoot}"/profiles/*.toml; do
        install -Dm644 "${_profile}" \
            "${pkgdir}/usr/share/rigsignal/profiles/$(basename "${_profile}")"
    done

    install -Dm644 "${_reporoot}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
